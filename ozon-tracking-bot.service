[Unit]
Description=Ozon tracking Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/lemetist/ozon-tracking-bot
ExecStart=/home/lemetist/ozon-tracking-bot/.venv/bin/python /home/lemetist/ozon-tracking-bot/bot.py
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=default.target
